# Comma-separated key pool (>= 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# Any LiteLLM model name, e.g. gemini/gemini-2.0-flash, gpt-4o-mini
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
# local = LiteLLM in-memory cache (default)
CACHE_TYPE=local
CACHE_DIR=/data/llm_cache
# Frontend build-time: public URL of the backend
VITE_API_URL=http://localhost:8000
